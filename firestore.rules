rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAllowedUser() {
      return isSignedIn() && (
        request.auth.token.email == 'hermanntalk@gmail.com' ||
        request.auth.token.email == 'trial@trip.com' ||
        request.auth.token.email != null
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Document
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || request.auth.token.email == 'hermanntalk@gmail.com');
      allow create, update: if isSignedIn() && isOwner(userId) && isValidId(userId);
      allow delete: if false;

      // User Sport Records (monthly)
      match /records/{monthId} {
        allow read: if isSignedIn() && (isOwner(userId) || request.auth.token.email == 'hermanntalk@gmail.com');
        allow create, update: if isSignedIn() && isOwner(userId);
        allow delete: if isSignedIn() && isOwner(userId);
      }

      // User Fitness Plans
      match /plans/{planId} {
        allow read: if isSignedIn() && (isOwner(userId) || request.auth.token.email == 'hermanntalk@gmail.com');
        allow create, update: if isSignedIn() && isOwner(userId) && isValidId(planId);
        allow delete: if isSignedIn() && isOwner(userId);
      }
    }

    // Public community messages / feedback
    match /community_messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
