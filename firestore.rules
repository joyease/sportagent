rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 驗證是否已通過 Firebase 認證登入
    function isSignedIn() {
      return request.auth != null;
    }

    // 驗證是否為該資料的擁有人 (比對 Auth UID)
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. 使用者個人文件及其子集合
    match /users/{userId} {
      // 只要是經 Firebase 認證的用戶本人即可讀寫自己的資料
      allow read, write: if isOwner(userId);

      // 每月運動紀錄子集合
      match /records/{monthId} {
        allow read, write: if isOwner(userId);
      }

      // 訓練計畫子集合
      match /plans/{planId} {
        allow read, write: if isOwner(userId);
      }

      // 運動特徵調查子集合
      match /survey_records/{periodId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. 「我的」頁面 - 社群打卡與即時留言板
    match /community_messages/{messageId} {
      // 經 Firebase 認證的用戶皆可讀取與發布留言
      allow read, write: if isSignedIn();
    }
  }
}
